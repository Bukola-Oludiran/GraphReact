<!-- M17-phase3b-real: simplest possible Go body — Counter returns an
     empty Manifest. The codegen-emitted dispatch.go expects a Go
     function named `CounterBody(ctx Ctx) Manifest`; GrxFunctionCall
     routes (Counter, "body") into bodyRegistry["Counter"] and invokes
     it. Mirrors python-smoke.grx's role for CPython. -->

<Counter lang="go">
func CounterBody(ctx Ctx) Manifest {
    return Manifest{
        ID:      ctx.ID,
        Accepts: []string{},
        Emits:   []string{},
    }
}
</Counter>

