<!-- M17-phase3b-real counter body — emits a placeholder manifest. The
     full Use*-driven counter (state + effect) ships in M17 phase 3c-h.
     Today's body returns the canonical accept/emit declarations so the
     codegen-emitted dispatch.go compiles cleanly and the engine-go
     LoadedRuntime can invoke it end-to-end. Mirrors python-counter.grx
     for CPython. -->

<Counter lang="go">
func CounterBody(ctx Ctx) Manifest {
    return Manifest{
        ID:      ctx.ID,
        Accepts: []string{"increment"},
        Emits:   []string{"count-updated"},
    }
}
</Counter>

<Graph id="go-counter">
  <Counter id="counter-1" />
</Graph>
