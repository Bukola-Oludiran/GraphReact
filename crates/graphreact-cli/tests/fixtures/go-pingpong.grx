<!-- M17-phase3b-real two-component fixture — bodies declare the
     accept/emit pairings the M17 phase 3c hook surface will exercise
     via UseEmit + UseMessage. Today's bodies return Manifest values
     statically; the runtime emit/message wiring lands in phase 3c.
     Mirrors python-pingpong.grx for CPython. -->

<Pinger lang="go">
func PingerBody(ctx Ctx) Manifest {
    return Manifest{
        ID:      ctx.ID,
        Accepts: []string{"pong"},
        Emits:   []string{"ping"},
    }
}
</Pinger>

<Ponger lang="go">
func PongerBody(ctx Ctx) Manifest {
    return Manifest{
        ID:      ctx.ID,
        Accepts: []string{"ping"},
        Emits:   []string{"pong"},
    }
}
</Ponger>

<Graph id="go-pingpong">
  <Pinger id="pinger-1" />
  <Ponger id="ponger-1" />
</Graph>
