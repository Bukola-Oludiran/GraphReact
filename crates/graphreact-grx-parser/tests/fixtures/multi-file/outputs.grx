<!-- Output component library — definitions only -->

<Logger>
  useMessage('sensor-data', (msg) => {
    const { sensorId, type, zone, value } = msg.payload;
    console.log(`  [${zone}] ${type} (${sensorId}): ${value}`);
  });

  return { accepts: ['sensor-data'], emits: [] };
</Logger>

<Aggregator>
  const [total, setTotal] = useState(0);
  const [count, setCount] = useState(0);
  const emit = useEmit();

  useMessage('sensor-data', (msg) => {
    const { value } = msg.payload;
    setTotal(prev => prev + value);
    setCount(prev => prev + 1);
  });

  useEffect(() => {
    if (count > 0) {
      console.log(`  Aggregator: ${count} readings, total=${total}, avg=${(total/count).toFixed(1)}`);
      emit('aggregate', { total, count, avg: total / count });
    }
  }, [total, count]);

  return { accepts: ['sensor-data'], emits: ['aggregate'] };
</Aggregator>
